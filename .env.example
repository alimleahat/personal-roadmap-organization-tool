# Copy to .env.local for local development, and set the same values as
# Environment Variables in your Vercel project for the deployed app.

# --- GitHub-backed storage -------------------------------------------------
# A fine-grained personal access token. Create one at:
#   https://github.com/settings/personal-access-tokens/new
#
#   Repository access : Only select repositories -> the repo below
#   Permissions       : Repository permissions -> Contents: Read and write
#
# Fine-grained tokens default to "Public Repositories" only. If your repo is
# private and you leave that default, the token authenticates fine but cannot
# see the repo, and you get a confusing 404. Select the repo explicitly.
GITHUB_TOKEN=

# The repo that stores your data.json. Use a PRIVATE repo — this file is your
# roadmap, and anything committed to a public repo stays in its history.
GITHUB_OWNER=your-github-username
GITHUB_REPO=my-roadmap-data

# Your repo's default branch. GitHub's default for new repos is "main", but
# older repos use "master". Getting this wrong gives a 404 on the file.
GITHUB_BRANCH=main

# Optional. Path to the data file inside that repo; defaults to data.json.
# DATA_PATH=data.json

# --- Access ----------------------------------------------------------------
# The passcode the app asks for. Leave blank locally to skip the prompt.
#
# This is NOT optional in production: a deployed URL is public, and without a
# passcode anyone who finds it can read and edit your roadmap. Use a random
# string, not a password you use elsewhere.
ROADMAP_PASSCODE=
